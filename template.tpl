scenarios:
- name: "Init - loads Clerk js and pushes config"
  code: |-
    const mockData = {
      actionType: 'init',
      apiKey: 'test-api-key-abc123',
      consentMode: 'off',
      enableDebug: false
    };

    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      onSuccess();
    });

    runCode(mockData);

    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();

- name: "Init - fails without API key"
  code: |-
    const mockData = {
      consentMode: 'off',
      actionType: 'init',
      apiKey: '',
      enableDebug: false
    };

    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      onSuccess();
    });

    runCode(mockData);

    assertApi('gtmOnFailure').wasCalled();

