___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const log = require('logToConsole');
const injectScript = require('injectScript');
const createArgumentsQueue = require('createArgumentsQueue');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const callInWindow = require('callInWindow');
const makeString = require('makeString');
const makeNumber = require('makeNumber');
const getType = require('getType');
const JSON = require('JSON');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');

const actionType = data.actionType;
const enableDebug = data.enableDebug;

const debugLog = function(message) {
  if (enableDebug) {
    log('Clerk.io GTM - ' + message);
  }
};

debugLog('Starting with action type: ' + actionType);

// Ensure the Clerk command queue exists and get the push function.
// Clerk.js uses: w.__clerk_q = w.__clerk_q || []; w.Clerk = w.Clerk || function(){ w.__clerk_q.push(arguments) };
// createArgumentsQueue maps exactly to this pattern.
const clerkPush = createArgumentsQueue('Clerk', '__clerk_q');

// Run the tag. Guarded so it runs at most once, even if the consent listener
// fires more than once.
let hasFired = false;
function fire() {
  if (hasFired) {
    return;
  }
  hasFired = true;

  if (actionType === 'init') {
    handleInit();
  } else {
    handleAction();
  }
}

// Consent gate. Clerk.io stores identifiers and reads behaviour for its
// recommendation engine, which requires analytics_storage. In the default
// "auto" mode the tag follows GTM Consent Mode: it fires once analytics_storage
// is granted and waits (via a consent listener) if it is not yet. Choose "Fire
// immediately" to gate consent at the container level instead. Note:
// isConsentGranted returns true when consent is not configured, so sites
// without Consent Mode keep firing.
const consentMode = data.consentMode || 'auto';

if (consentMode === 'off' || isConsentGranted('analytics_storage')) {
  fire();
} else {
  debugLog('Waiting for analytics_storage consent');
  addConsentListener('analytics_storage', function(consentType, granted) {
    if (granted) {
      fire();
    }
  });
}

function handleInit() {
  var apiKey = data.apiKey;

  if (!apiKey) {
    debugLog('Error: API key is required for initialisation');
    data.gtmOnFailure();
    return;
  }

  // Build config object
  var config = {
    key: makeString(apiKey)
  };

  if (data.language) {
    config.language = makeString(data.language);
  }

  if (data.collectEmail) {
    config.collect_email = true;
  }

  // Push config command before loading script
  clerkPush('config', config);
  debugLog('Pushed config with key: ' + apiKey);

  // Inject Clerk.js
  injectScript('https://cdn.clerk.io/clerk.js', function() {
    debugLog('Clerk.js loaded successfully');
    data.gtmOnSuccess();
  }, function() {
    debugLog('Clerk.js failed to load');
    data.gtmOnFailure();
  }, 'clerkio');
}

function handleAction() {
  if (actionType === 'productView') {
    handleProductView();
  } else if (actionType === 'cart') {
    handleCart();
  } else if (actionType === 'sale') {
    handleSale();
  } else if (actionType === 'search') {
    handleSearch();
  } else {
    debugLog('Unknown action type: ' + actionType);
    data.gtmOnFailure();
    return;
  }

  data.gtmOnSuccess();
}

function handleProductView() {
  var productId = data.productId;

  if (!productId) {
    debugLog('Error: Product ID is required');
    data.gtmOnFailure();
    return;
  }

  // Use the Clerk call API to log a product click/view
  clerkPush('call', 'log/clicked', {
    product: makeString(productId)
  });
  debugLog('Tracked product view for ID: ' + productId);
}

function handleCart() {
  var cartProductIds = data.cartProductIds;

  if (!cartProductIds) {
    debugLog('Error: Cart product IDs are required');
    data.gtmOnFailure();
    return;
  }

  // Parse if it is a JSON string, otherwise use as-is (already an array)
  var ids = cartProductIds;
  if (getType(cartProductIds) === 'string') {
    ids = JSON.parse(cartProductIds);
  }

  if (!ids || getType(ids) !== 'array') {
    debugLog('Error: Cart product IDs must be an array');
    data.gtmOnFailure();
    return;
  }

  // Clerk('cart', 'set', [array of ids])
  clerkPush('cart', 'set', ids);
  debugLog('Set cart with ' + ids.length + ' products');
}

function handleSale() {
  var orderId = data.orderId;
  var saleProductIds = data.saleProductIds;

  if (!orderId || !saleProductIds) {
    debugLog('Error: Order ID and product IDs are required');
    data.gtmOnFailure();
    return;
  }

  // Parse product IDs if string
  var ids = saleProductIds;
  if (getType(saleProductIds) === 'string') {
    ids = JSON.parse(saleProductIds);
  }

  if (!ids || getType(ids) !== 'array') {
    debugLog('Error: Product IDs must be an array');
    data.gtmOnFailure();
    return;
  }

  // Build sale payload for the log/sale API call
  var salePayload = {
    sale: makeString(orderId),
    products: ids
  };

  if (data.customerEmail) {
    salePayload.email = makeString(data.customerEmail);
  }

  clerkPush('call', 'log/sale', salePayload);
  debugLog('Tracked sale for order: ' + orderId);
}

function handleSearch() {
  var searchQuery = data.searchQuery;

  if (!searchQuery) {
    debugLog('Error: Search query is required');
    data.gtmOnFailure();
    return;
  }

  clerkPush('call', 'search/search', {
    query: makeString(searchQuery)
  });
  debugLog('Tracked search for query: ' + searchQuery);
}


